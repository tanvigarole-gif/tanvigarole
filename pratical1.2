# Declare constant-like variables
PI = 3.14159
GRAVITY = 9.8
MAX_USERS = 100

# Print the values
print("PI:", PI)
print("GRAVITY:", GRAVITY)
print("MAX_USERS:", MAX_USERS)

# Attempt to change their values
PI = 3.14
GRAVITY = 9.81
MAX_USERS = 150

print("After changing:")
print("PI:", PI)
print("GRAVITY:", GRAVITY)
print("MAX_USERS:", MAX_USERS)
